<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select name="organizationId" id="organizationId">
                    <% organizations.forEach(organization=> { %>

                        <option id="organization-<%= organization.organization_id %>"
                            value="<%= organization.organization_id %>"
                            <%= projectDetails.organization_id==organization.organization_id ? 'selected' : '' %>>
                            <%= organization.organization_name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" required maxlength="150"
                    value="<%= projectDetails.project_title %>" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required maxlength="500">
                    <%= projectDetails.project_description %>
                </textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" required maxlength="150"
                    value="<%= projectDetails.project_location %>" />
            </div>
            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" required value="<%= projectDetails.project_date.toISOString().split('T')[0] %>" />
            </div>

            <button type="submit">Update Project</button>
        </form>

    </main>
    <%- include('partials/footer') %>
<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <% organizationDetails.organization_name %>
        </h2>

        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.organization_name %>"
            height="100" width="100">
        <p>
            <%= organizationDetails.organization_description %>
        </p>
        <h3>Service Projects</h3>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.project_title %>
                    </a>
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>
<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>
            <%= project.project_title %>
        </h2>
        <p>
            <%= project.project_description %>
        </p>
        <p>
            <%= project.project_date.toISOString().split('T')[0] %>
        </p>
        <p>
            <%= project.project_location %>
        </p>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
        <h3>Categories</h3>
        <ul>
            <% categories.forEach(category=> { %>
                <a href="/category/<%= category.category_id %>">
                    <li>
                        <%= category.category_name %>
                    </li>
                </a>
                <% }) %>
        </ul>
        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
            <% } %>
                <% if (user && user.role_name==='admin' ) { %>
                    <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a> </p>
                    <% } %>

                        <% if (isLoggedIn) { %>
                            <%if(!userProject){%>
                                <form action="/add-volunteer/<%=project.project_id %>" method="POST">
                                    <button type="submit">Volunteer</button>
                                </form>
                                <%} else { %>
                                    <form action="/remove-volunteer/<%=project.project_id %>" method="POST">
                                        <button type="submit">Un-Volunteer</button></form>
                                    <%} %>
                                        <% } %>
    </main>
    <%- include('partials/footer') %>
<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>
        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>

        <% if(userProjects!=null){ userProjects.forEach(project=>{ %>
            <a href="/project/<%= project.project_id%>">
                <li>
                    <%= project.project_title %>:
                        <form action="/remove-volunteer/<%=project.project_id %>" method="POST">
                            <button type="submit">Un-Volunteer</button>
                        </form>
                </li>
            </a>
            <% })}; %>

    </main>

    <% if (user && user.role_name==='admin' ) { %>
        <p><a href="/Users">View Users</a></p>
        <% } %>
            <%- include('partials/footer') %>